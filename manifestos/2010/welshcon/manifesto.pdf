   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Members of 15 Squadron RAF Regiment play football with children on one of the last patrols during combat operations by the British in Basra Province, Iraq.</rdf:li>
    </rdf:Alt>
   </dc:description>
